{"name": "pct_inv_lead_bs", "lines": ["( ä\\) )"], "keys": "%", "bytes": true}
{"name": "pct_inv_quote_cont", "lines": ["(a \"\u0080)\" b)"], "keys": "%", "bytes": true}
{"name": "pct_inv_quote_lead_bs", "lines": ["(a \"Ã\\\"\" b)"], "keys": "%", "bytes": true}
{"name": "pct_inv_quote_lead_bs_back", "lines": ["(a \"Ã\\\"\" b)"], "keys": "$%", "bytes": true}
