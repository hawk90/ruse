{"name": "pct_inv_bs1_cont_open_back", "lines": ["( \\\u0080( )"], "keys": "$%", "bytes": true}
{"name": "pct_inv_bs_cont2", "lines": ["( \\\u0080\u0080) )"], "keys": "%", "bytes": true}
{"name": "pct_inv_bs_cont3", "lines": ["( \\\u0080\u0080\u0080) )"], "keys": "%", "bytes": true}
{"name": "pct_inv_bs_cont4", "lines": ["( \\\u0080\u0080\u0080\u0080) )"], "keys": "%", "bytes": true}
