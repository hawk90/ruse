# --- #1163 `%` as nvim's findmatchlimit: quotes, 'c' literals, escapes, `/* */`, `#if`/`#else`/`#endif`,
#     and the 'lisp' rules (`;` comments, `#\\(` characters). ---
{"name": "pct_quote", "lines": ["(a \")\" b)"], "keys": "%"}
{"name": "pct_quote_back", "lines": ["(a \"(\" b)"], "keys": "$%"}
{"name": "pct_char_lit", "lines": ["(a ')' b)"], "keys": "%"}
{"name": "pct_char_lit_esc", "lines": ["(a '\\)' b)"], "keys": "%"}
