{"name": "pct_in_quotes_start", "lines": ["\"(a)\" (b)"], "keys": "l%"}
{"name": "pct_cursor_before", "lines": ["x = f(a, b);"], "keys": "%"}
{"name": "pct_multiline_quote", "lines": ["f(\"a)\",", "b)"], "keys": "%"}
{"name": "pct_eol_backslash", "lines": ["f(\"a \\", ")\")", "x"], "keys": "%"}
{"name": "pct_nothing", "lines": ["abc"], "keys": "%"}
{"name": "pct_brace_mix", "lines": ["{ ( } )"], "keys": "%"}
{"name": "pct_op_d", "lines": ["(a \")\" b) c"], "keys": "d%"}
{"name": "pct_comment_start", "lines": ["/* a", "b */ x"], "keys": "%"}
{"name": "pct_comment_end", "lines": ["/* a", "b */ x"], "keys": "j$hh%"}
{"name": "pct_comment_star", "lines": ["/* a */"], "keys": "l%"}
{"name": "pct_ifdef", "lines": ["#if A", "x", "#else", "y", "#endif"], "keys": "%"}
{"name": "pct_ifdef_chain", "lines": ["#if A", "x", "#else", "y", "#endif"], "keys": "%%%"}
{"name": "pct_ifdef_nested", "lines": ["#ifdef A", "#if B", "#endif", "#endif"], "keys": "%"}
{"name": "pct_ifdef_indented", "lines": ["  #  if A", "x", "  #endif"], "keys": "%"}
{"name": "pct_hash_no_if", "lines": ["#define X (1)"], "keys": "%"}
{"name": "pct_lisp_comment", "lines": ["(a ; )", "b)"], "keys": ":set lisp<CR>%"}
{"name": "pct_nolisp_comment", "lines": ["(a ; )", "b)"], "keys": "%"}
