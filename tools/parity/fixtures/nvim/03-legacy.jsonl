{"name": "pct_lisp_string_semicolon", "lines": ["(a \";\" )"], "keys": ":set lisp<CR>%"}
{"name": "pct_lisp_back", "lines": ["(a", "; (", "b)"], "keys": ":set lisp<CR>G$%"}
# #1548: the backslashes before a bracket are counted with `check_prevcol`, whose `utf_head_off` step
# stops on a byte no valid char owns (and goes back over a cluster: `\` + a combining mark is a `\`);
# the backslashes before a `"` are raw bytes. Default 'cpoptions' (no `M`, no `%`).
{"name": "pct_inv_bs1_cont", "lines": ["( \\\u0080) )"], "keys": "%", "bytes": true}
{"name": "pct_inv_bs2_cont", "lines": ["( \\\\\u0080) )"], "keys": "%", "bytes": true}
{"name": "pct_inv_bs3_cont", "lines": ["( \\\\\\\u0080) )"], "keys": "%", "bytes": true}
{"name": "pct_inv_bs_cont_bs", "lines": ["( \\\u0080\\) )"], "keys": "%", "bytes": true}
